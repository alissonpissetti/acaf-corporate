# Dev: vazio usa proxy do Vite (/api → acaf-api). Produção: vazio + nginx proxy, ou URL absoluta da API.
VITE_API_URL=

# Coolify — variável OBRIGATÓRIA no serviço acaf-corporate (runtime, não só no build):
# API_BACKEND_URL=http://ucskoskgsgcswk0sock84sg4.76.13.66.204.sslip.io
# Porta 80 (sem :8787). O nginx faz proxy de /api → API_BACKEND_URL.
# Não use só VITE_API_URL no build — ela não substitui API_BACKEND_URL no container.

# Opcional: chamar a API por URL absoluta no browser (só se HTTP/HTTPS compatível com o portal):
# ACAF_API_DIRECT=1
