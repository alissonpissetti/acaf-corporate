# Dev local: proxy Vite → connect-api (acaf-api em :8787)
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# Sem API local, aponte para o Coolify (deploy da API precisa estar atualizado):
# VITE_API_PROXY_TARGET=http://ucskoskgsgcswk0sock84sg4.76.13.66.204.sslip.io

# Produção build: vazio usa proxy nginx /api
VITE_API_URL=

# Coolify — variável OBRIGATÓRIA no serviço connect-corporate (Runtime, não só Build):
# API_BACKEND_URL=http://ucskoskgsgcswk0sock84sg4.76.13.66.204.sslip.io
# Sem :8787. O nginx faz proxy de /api → API_BACKEND_URL.

# Opcional: chamar a API por URL absoluta no browser (só se HTTP/HTTPS compatível com o portal):
# CONNECT_API_DIRECT=1
